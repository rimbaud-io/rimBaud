# Spring debug brain. Generated by daemon/install.sh — do not edit by hand.
# Never binds :5001 (Flask). Never starts Docker hunters. Never closes HL clips.

[Unit]
Description=Spring Freiquell debug brain (:@PORT@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
@USER_LINE@
WorkingDirectory=@WORKDIR@
ExecStart=@SPRING_BIN@ --debug --conf @CONF@ --port @PORT@
Restart=always
RestartSec=2
TimeoutStopSec=8
StandardOutput=append:@LOG@
StandardError=append:@LOG@
SyslogIdentifier=spring
Environment=FREIQUELL_CONF=@CONF@
# Refuse colliding with live Flask.
Environment=FREIQUELL_DEBUG_PORT=@PORT@

[Install]
WantedBy=@WANTED_BY@
