# Build context is the repository root. Spring listens on SPRING_BIND so
# Docker can publish port 5004. springctl is not built.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ make libsqlite3-0 libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY apps/spring /src/apps/spring
COPY third_party /src/third_party
WORKDIR /src/apps/spring
RUN make spring

ENV SPRING_BIND=0.0.0.0
EXPOSE 5004
CMD ["./spring", "--debug", "--conf", "/conf", "--port", "5004"]
