# Copy to the repo root as `.env` (docker compose reads it).
# Fresh machine: pick a NEW CONFIG_PASSWORD, then paste unique wallets in setup TUI / Confiig.
# Do NOT reuse wallets from another rimBaud box.

CONFIG_PASSWORD=change-me

# Copy hunter main wallet (0x…). Empty until setup.
HL_COPY_WALLET=

COMPOSE_PROJECT_NAME=hummingbird

# Spring (never 5001 — that is Flask).
SPRING_PORT=5004

# Optional Condor gauge.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# XAI_API_KEY=
# CONDOR_INTERVAL=600
