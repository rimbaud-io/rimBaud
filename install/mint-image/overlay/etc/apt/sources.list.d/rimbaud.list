# rimBaud internal packages. Official Mint/Ubuntu lines stay in the stock sources.
# file:// is the ISO-local repo (always present). Uncomment the https line when
# you publish a real package server (set apt_repo in mint-image/config.json).
deb [trusted=yes] file:/var/lib/rimbaud/apt ./
# deb [signed-by=/etc/apt/keyrings/rimbaud.gpg] https://YOUR-REPO.example/rimbaud stable main
