[Desktop Entry]
Type=Application
Name=rimBaud restore
Comment=Write the latest data-disk image when this boot asked for it
Exec=/usr/bin/python3 /opt/rimbaud/install_new/backup-restore.py
X-GNOME-Autostart-enabled=true
OnlyShowIn=X-Cinnamon;GNOME;XFCE;
NoDisplay=true
