[Desktop Entry]
Type=Application
Name=rimBaud Meta
Comment=Matrix mothership — HOME + DEPLOY (never CLOSE/OPEN)
Exec=/usr/local/bin/rimbaud-meta-desk
Icon=/usr/share/pixmaps/rimbaud.png
Terminal=false
Categories=System;
StartupNotify=true
