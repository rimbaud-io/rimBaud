# Launch Meta desk from the appliance tree. Compiles once if missing.
set -euo pipefail
export PATH="${HOME}/.local/bin:/opt/rimbaud/rimbaud_meta_c++:/usr/local/bin:${PATH:-/usr/bin}"
BIN="/opt/rimbaud/rimbaud_meta_c++/rimbaud-meta-desk"
if [ ! -x "$BIN" ] && [ -x /opt/rimbaud/install_new/desk.sh ]; then
  /opt/rimbaud/install_new/desk.sh >/tmp/rimbaud-desk-build.log 2>&1 || true
fi
if [ -x "${HOME}/.local/bin/rimbaud-meta-desk" ]; then
  exec "${HOME}/.local/bin/rimbaud-meta-desk" "$@"
fi
if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
fi
echo "rimbaud-meta-desk not built — run: sudo /opt/rimbaud/install_new/desk.sh" >&2
exit 1
